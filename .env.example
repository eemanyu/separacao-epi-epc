# Porta HTTP
PORT=3000

# Banco SQLite (caminho absoluto ou relativo)
DB_PATH=./data/separacao.db

# Pasta dos arquivos Excel recebidos
UPLOADS_DIR=./data/uploads

# Chave que o sistema de origem envia em X-API-Key nas rotas /api/integracao/*
INTEGRATION_API_KEY=troque-esta-chave

# URL que recebe o webhook de separacao concluida
WEBHOOK_URL=https://seu-sistema.exemplo/api/webhooks/separacao

# Segredo do HMAC do webhook (header X-Assinatura: sha256=...)
WEBHOOK_SECRET=troque-este-segredo

# Intervalo do worker de reenvio (ms)
WEBHOOK_INTERVALO_MS=30000

# Permite upload pela tela /importar.html (false em producao, se o upload vier so do sistema de origem)
PERMITIR_UPLOAD_UI=true

# Tamanho maximo do Excel em MB
MAX_UPLOAD_MB=10
